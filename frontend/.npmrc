# Next.js and Tailwind resolve a handful of transitive packages they do not declare, so the
# dashboard build fails under pnpm's strict default. Hoisting only those patterns keeps the
# rest of the tree isolated.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@tailwindcss/*

# Workspace packages are consumed from source, so a version range must never resolve to the
# registry copy by accident.
link-workspace-packages=true
strict-peer-dependencies=false
