{
  "name": "rag-frontend",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "generate": "turbo run generate",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,css,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3"
  }
}
