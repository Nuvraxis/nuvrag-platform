# Build context hygiene. Anything listed here is either rebuilt inside the image or has no
# business being in one.

.git
.gitignore
.venv
.pytest_cache
.ruff_cache
__pycache__/
*.pyc

node_modules/
frontend/**/node_modules/
frontend/**/.next/
frontend/**/.turbo/
frontend/apps/widget/dist/

# Secrets stay out of the context entirely, not merely out of the final layer.
.env
.env.*
!.env.example

var/
*.log
devplans/
tests/
