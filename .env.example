# Copy to .env for local development. Never commit real secrets — cluster values belong in
# infra/helm/values-secrets.yaml, which is gitignored, or in a Secret created out of band.

ENVIRONMENT=local
PROJECT_NAME=RAG Chatbot Platform
DOCS_ENABLED=true
WIDGET_CDN_BASE_URL=http://localhost:8080/widget
# Used to build invitation links, so it must be the URL teammates actually open.
DASHBOARD_BASE_URL=http://localhost:3000

# --- Database -------------------------------------------------------------------------
# Accepts postgresql+asyncpg://, postgresql:// or asyncpg:// and normalises the driver.
DB_CONNECTION_STRING=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db
# Optional read replica; chat retrieval reads from it while ingestion writes to the primary.
# DB_READ_REPLICA_DSN=
# Table-owner role used for migrations and pre-tenant lookups (login, signup) once RLS is on.
# DB_PRIVILEGED_DSN=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=15000
# Set when connecting through PgBouncer in transaction pooling mode.
DB_PGBOUNCER_TRANSACTION_MODE=false

# --- Redis ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# REDIS_BROKER_URL=
# REDIS_RESULT_BACKEND_URL=
REDIS_CHATBOT_CACHE_TTL_SECONDS=60

# --- Security -------------------------------------------------------------------------
SECURITY_JWT_SECRET=change-me-to-a-long-random-value
SECURITY_ACCESS_TOKEN_TTL_SECONDS=900
SECURITY_REFRESH_TOKEN_TTL_SECONDS=1209600
# Comma-separated, or a JSON array. Both are accepted.
SECURITY_DASHBOARD_CORS_ORIGINS=http://localhost:3000
SECURITY_PASSWORD_MIN_LENGTH=10
SECURITY_INVITATION_TTL_SECONDS=604800

# --- AI providers ---------------------------------------------------------------------
# Which provider a chatbot uses (Azure, Bedrock, Anthropic or Ollama) and the credentials
# for it are configured per chatbot in the dashboard, not here. This key is what encrypts
# those credentials at rest, so losing it means every tenant re-entering theirs.
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Required: the application refuses to start without a valid one.
AI_CREDENTIALS_ENCRYPTION_KEY=
AI_EMBEDDING_BATCH_SIZE=100
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
# Ceiling on a "test connection" call, which runs inside a dashboard request.
AI_TEST_TIMEOUT_SECONDS=20

# --- Object storage -------------------------------------------------------------------
# local | azure_blob | s3
STORAGE_BACKEND=local
STORAGE_CONTAINER=rag-documents
STORAGE_LOCAL_ROOT=./var/uploads
# STORAGE_AZURE_CONNECTION_STRING=
# STORAGE_AZURE_ACCOUNT_URL=https://youraccount.blob.core.windows.net
# STORAGE_S3_ENDPOINT_URL=http://localhost:9000
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# --- Ingestion ------------------------------------------------------------------------
INGESTION_MAX_UPLOAD_BYTES=26214400
INGESTION_CHUNK_SIZE_TOKENS=700
INGESTION_CHUNK_OVERLAP_TOKENS=90
INGESTION_MAX_TASK_RETRIES=4
# Malware scanning is off until a host is set. Once set it is mandatory: a scanner that
# cannot be reached fails the ingestion job rather than letting the file through unscanned.
# INGESTION_CLAMAV_HOST=clamav
# INGESTION_CLAMAV_PORT=3310

# --- Retrieval ------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.25
RETRIEVAL_HISTORY_WINDOW_MESSAGES=8
RETRIEVAL_HNSW_EF_SEARCH=80

# --- Conversation retention -------------------------------------------------------------
# Only *when* the sweep runs. How long a transcript is kept is per chatbot
# (`retention_days`, set in the dashboard), and the default there is to keep it forever.
# The sweep runs on `celery beat`, which is a separate process from the worker:
#   uv run celery -A app.worker.celery_app.celery_app beat --loglevel=INFO
# Without it these settings do nothing, whatever a tenant has chosen.
RETENTION_ENABLED=true
RETENTION_PURGE_HOUR_UTC=3
RETENTION_PURGE_MINUTE_UTC=30
RETENTION_PURGE_BATCH_SIZE=500
RETENTION_PURGE_MAX_BATCHES_PER_CHATBOT=40

# --- nuvrag_mem: per-visitor memory ----------------------------------------------------
# Short facts about a returning visitor, written during a conversation and retrieved on the
# next one. Only for visitors who have opened a ticket — that is the one class of visitor
# with a durable identity, and giving every visitor one is a product decision this project
# has deliberately not taken.
#
# How long an entry is kept is per chatbot, not here: `nuvrag_mem_retention_days` in the
# dashboard. Unlike conversation retention it starts at 30 days rather than at "forever".
NUVRAG_MEM_ENABLED=true
# Smaller than RETRIEVAL_TOP_K, and with a higher floor. An irrelevant document passage is
# ignorable; an irrelevant "fact about you" is the assistant confidently telling a visitor
# something untrue about themselves.
NUVRAG_MEM_RETRIEVAL_TOP_K=5
NUVRAG_MEM_RETRIEVAL_MIN_SIMILARITY=0.45
# Write path: how much recent conversation the extractor sees, how many statements one turn
# may produce, and how similar a new statement must be to an existing one to count as a
# restatement and be dropped.
NUVRAG_MEM_EXTRACTION_WINDOW_MESSAGES=6
NUVRAG_MEM_MAX_ENTRIES_PER_EXTRACTION=3
NUVRAG_MEM_DEDUPE_SIMILARITY=0.92
NUVRAG_MEM_MAX_ENTRIES_PER_SUBJECT=200
# Rides the same `celery beat` process as the conversation sweep, fifteen minutes after it,
# and never shares its lock key — one key for two sweeps would let the first silently skip
# the second.
NUVRAG_MEM_PURGE_HOUR_UTC=3
NUVRAG_MEM_PURGE_MINUTE_UTC=45
NUVRAG_MEM_PURGE_BATCH_SIZE=500
NUVRAG_MEM_PURGE_MAX_BATCHES_PER_CHATBOT=40

# --- Rate limiting --------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHATBOT_CAPACITY=120
RATE_LIMIT_CHATBOT_REFILL_PER_SECOND=2.0
RATE_LIMIT_SESSION_CAPACITY=20
RATE_LIMIT_SESSION_REFILL_PER_SECOND=0.25

# Opening a ticket ("Talk to a human") gets its own, much tighter buckets. The session id the
# other limits key on is generated in the browser, so a caller can rotate it; these key on the
# client address, which it cannot. Roughly 5/hour per address and 36/hour per chatbot.
RATE_LIMIT_TICKET_IP_CAPACITY=3
RATE_LIMIT_TICKET_IP_REFILL_PER_SECOND=0.0014
RATE_LIMIT_TICKET_CHATBOT_CAPACITY=30
RATE_LIMIT_TICKET_CHATBOT_REFILL_PER_SECOND=0.01

# Which header carries the real client address. Cloudflare overwrites CF-Connecting-IP on
# every proxied request, so unlike X-Forwarded-For a value the caller sends is discarded.
# Behind a different proxy, name its equivalent; leave it empty to use the socket address.
# This is only trustworthy if the origin cannot be reached around the proxy — see the README.
SECURITY_CLIENT_IP_HEADER=cf-connecting-ip

# --- Observability --------------------------------------------------------------------
OTEL_SERVICE_NAME=rag-api
OTEL_LOG_LEVEL=INFO
OTEL_LOG_FORMAT=json
OTEL_METRICS_ENABLED=true
OTEL_TRACING_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
